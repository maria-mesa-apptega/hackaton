{
  "name": "apptega-compliance-copilot",
  "version": "1.0.0",
  "description": "AI-powered compliance assistant for Apptega platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "deploy": "sls deploy --stage dev",
    "deploy:prod": "sls deploy --stage prod",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .serverless",
    "prepare": "husky install"
  },
  "keywords": [
    "compliance",
    "ai",
    "serverless",
    "aws",
    "bedrock",
    "apptega"
  ],
  "author": "Apptega Development Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.654.0",
    "@aws-sdk/client-dynamodb": "^3.654.0",
    "@aws-sdk/lib-dynamodb": "^3.654.0",
    "@aws-lambda-powertools/logger": "^2.7.0",
    "@aws-lambda-powertools/tracer": "^2.7.0",
    "@aws-lambda-powertools/metrics": "^2.7.0",
    "@middy/core": "^6.0.0",
    "@middy/http-cors": "^6.0.0",
    "@middy/http-error-handler": "^6.0.0",
    "@middy/http-json-body-parser": "^6.0.0",
    "@middy/validator": "^6.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "mysql2": "^3.11.3",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@serverless/typescript": "^3.38.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "serverless": "^4.4.3",
    "serverless-esbuild": "^1.54.3",
    "serverless-offline": "^14.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
